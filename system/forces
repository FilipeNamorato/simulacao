FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      forces;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

forces
{
    type            forces;
    libs            ("libforces.so");
    patches         (helice);
    rho             rhoInf;
    rhoInf          1.225;
    CofR            (0 0 0);
    log             yes;
    writeControl    timeStep;
    writeInterval   1;
}


