FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // --- SOLVER DE MALHA (Essencial para 6DoF) ---
    cellDisplacement
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
    }

    // --- PRESSÃO (A mudança chave: PCG é "blindado") ---
    "p|pFinal|pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          0.01;
    }

    // --- VELOCIDADE E TURBULÊNCIA ---
    "(U|k|epsilon|omega).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }
}

// --- CONTROLE PIMPLE (Só uma vez!) ---
PIMPLE
{
    correctPhi          yes;
    
    // Configuracao robusta:
    nOuterCorrectors    5;  // Mantém 5 para garantir que convirja a cada passo
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;
    
    moveMeshOuterCorrectors yes; // Recalcula o movimento várias vezes (vital!)
}

// --- RELAXAMENTO (Freio de mão) ---
relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        ".*"            0.3; // Segura tudo, inclusive k e epsilon
    }
}

// --- Otimização de memória ---
cache
{
    grad(U);
}

