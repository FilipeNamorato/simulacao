FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       startTime; // Começando do zero para garantir a rampa correta
startTime       0;
stopAt          endTime;
endTime         12;        // Tempo total citado no documento

// Passo de tempo inicial (pequeno para o arranque)
deltaT          0.00001;

writeControl    adjustableRunTime;
writeInterval   0.1;       // Salvando a cada 0.1s para não encher o disco
purgeWrite      0;
writeFormat     binary;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// --- CONTROLE DE PASSO DE TEMPO ---
// Como é movimento prescrito (mais estável), podemos deixar automático
adjustTimeStep  yes;
maxCo           2.0;       // PIMPLE aguenta Courant alto
maxAlphaCo      2.0;
maxDeltaT       0.01;      // Teto para não perder resolução física

// --- BIBLIOTECAS ---
// Trocamos a libsixDoF pela libfvMotionSolvers (Movimento Sólido)
libs            ("libfvMotionSolvers.so" "libforces.so");

functions
{
    // Monitoramento de Forças (Essencial para os gráficos de Torque)
    monitoramento
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        
        // Ajuste o nome dos patches das suas pás aqui
        patches         (helice); 

        rho             rhoInf;
        rhoInf          1.104; // Densidade calculada no documento

        // Dados geométricos (ajuste conforme seu CAD)
        CofR            (0 0 0);
        liftDir         (0 1 0);  
        dragDir         (1 0 0);  
        pitchAxis       (0 0 1);
        magUInf         6.0;      // Velocidade do vento
        lRef            0.436;    // Diâmetro   
        Aref            0.149;    // Area = pi*r^2 (Aprox)

        writeControl    timeStep;
        writeInterval   1;
        log             yes;
    }
}

