FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         12;

// DeltaT inicial bem pequeno para o primeiro passo
deltaT          0.000005;

writeControl    adjustableRunTime;
writeInterval   0.01; // Salvando frequente no início para monitorar
purgeWrite      0;
writeFormat     binary;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;

// --- IMPORTANTE: Deixe 'true' para podermos acelerar depois sem parar a simulação ---
runTimeModifiable true;

// --- CONTROLE DE PASSO DE TEMPO (MODO SEGURANÇA) ---
adjustTimeStep  no;

// Travas agressivas para passar da fase de aceleração (0.0s a 0.1s)
maxCo           0.8;     // Bem conservador
maxAlphaCo      0.5;
maxDeltaT       0.0001;  // Teto baixo para evitar pulos grandes

// Carregando as bibliotecas
libs            ("libsixDoFRigidBodyMotion.so" "libforces.so");

functions
{
    monitoramento
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        
        patches         (helice); 

        rho             rhoInf;
        rhoInf          1.225;

        // Dados geométricos
        CofR            (0 0 0);
        liftDir         (0 1 0);  
        dragDir         (1 0 0);  
        pitchAxis       (0 0 1);
        magUInf         10;
        lRef            1;        
        Aref            1;        

        writeControl    timeStep;
        writeInterval   1;
        log             yes;
    }
}

