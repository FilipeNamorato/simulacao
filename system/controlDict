FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         12;
deltaT          0.00001;
writeControl    adjustableRunTime;
writeInterval   0.05;
purgeWrite      0;
writeFormat     binary;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;

adjustTimeStep  yes;
maxCo           1.0;
maxDeltaT       0.01;

// Carregando as bibliotecas (Importante!)
libs            ("libsixDoFRigidBodyMotion.so" "libforces.so");

functions
{
    // USANDO forceCoeffs EM VEZ DE forces
    // Isso evita o erro de "Dynamic Pressure" e "Could not find rho"
    
    monitoramento
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        
        patches         (helice); 

        // Configuração Mágica que resolve o problema
        rho             rhoInf;
        rhoInf          1.225;

        // Dados geométricos (Não afetam se a simulação roda, só os valores de Cd/Cl)
        // Ajuste conforme sua geometria se precisar de precisão nos coeficientes
        CofR            (0 0 0);  // Centro de rotação
        liftDir         (0 1 0);  
        dragDir         (1 0 0);  
        pitchAxis       (0 0 1);
        magUInf         10;       // Velocidade de referência
        lRef            1;        
        Aref            1;        

        writeControl    timeStep;
        writeInterval   1;
        log             yes;
    }
}

