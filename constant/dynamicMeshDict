FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh       dynamicMotionSolverFvMesh;

motionSolverLibs    ("libsixDoFRigidBodyMotion.so");

motionSolver        sixDoFRigidBodyMotion;

patches             ("helice");

// Definição da densidade para o 6DoF
rho                 rhoInf;
rhoInf              1.225;

innerDistance       0.05;
outerDistance       0.1;

// --- DADOS DA HÉLICE (MODIFICADOS PARA ESTABILIDADE) ---
mass                0.063103;
centreOfMass        (0 0 0);

// Inércia AUMENTADA em 100x para suavizar a aceleração inicial
// Valores originais: (0.0002823 0.0005562 0.0002823)
momentOfInertia     (0.02823 0.05562 0.02823);

// --- TRAVAS (CONSTRAINTS) ---
constraints
{
    fixedPoint
    {
        sixDoFRigidBodyMotionConstraint point;
        centreOfMass    (0 0 0);
    }

    fixedAxis
    {
        sixDoFRigidBodyMotionConstraint axis;
        axis            (0 1 0);
    }
}

// --- AMORTECIMENTO (RESTRAINTS) ---
restraints
{
    motorFriction
    {
        sixDoFRigidBodyMotionRestraint sphericalAngularDamper;
        // Amortecimento AUMENTADO em 100x para simular carga
        // Valor original: 0.0005
        coeff           0.05;
    }
}

solver
{
    type Newmark;
}