FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh       dynamicMotionSolverFvMesh;

motionSolverLibs    ("libsixDoFRigidBodyMotion.so");

motionSolver        sixDoFRigidBodyMotion;

patches             ("helice");

// --- AQUI ESTAVA O PROBLEMA ---
// Você precisa dizer explicitamente que a densidade (rho) é o rhoInf
rho                 rhoInf;  // <--- LINHA NOVA OBRIGATÓRIA
rhoInf              1.225;

innerDistance       0.05;
outerDistance       0.1;

// --- DADOS DA HÉLICE ---
mass                0.063103;
centreOfMass        (0 0 0);
momentOfInertia     (0.0002823 0.0005562 0.0002823);

// --- TRAVAS (CONSTRAINTS) ---
constraints
{
    fixedPoint
    {
        sixDoFRigidBodyMotionConstraint point;
        centreOfMass    (0 0 0);
    }

    fixedAxis
    {
        sixDoFRigidBodyMotionConstraint axis;
        axis            (0 1 0);
    }
}

// --- AMORTECIMENTO (RESTRAINTS) ---
restraints
{
    motorFriction
    {
        sixDoFRigidBodyMotionRestraint sphericalAngularDamper;
        coeff           0.0005;
    }
}

solver
{
    type Newmark;
}