FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.09879;

boundaryField
{
    walls
    {
        lowReCorrection 0;
        blending        stepwise;
        n               2;
        type            epsilonWallFunction;
        value           uniform 0.09879;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 0.09879;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0;
        value           nonuniform List<scalar> 0;
    }
    helice
    {
        lowReCorrection 0;
        blending        stepwise;
        n               2;
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0;
    }
    AMI1
    {
        type            cyclicAMI;
        value           nonuniform List<scalar> 0;
    }
    AMI2
    {
        type            cyclicAMI;
        value           nonuniform List<scalar> 0;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 0.09879;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 0.09879;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.09879;
    }
    procBoundary2to4
    {
        type            processor;
        value           uniform 0.09879;
    }
    procBoundary2to5
    {
        type            processor;
        value           uniform 0.09879;
    }
}


