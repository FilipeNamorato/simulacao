FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       pointVectorField;
    location    "0";
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    walls
    {
        type            fixedValue;
        value           nonuniform List<vector> 0;
    }
    inlet
    {
        type            fixedValue;
        value           nonuniform List<vector> 0;
    }
    outlet
    {
        type            fixedValue;
        value           nonuniform List<vector> 0;
    }
    helice
    {
        type            calculated;
    }
    AMI1
    {
        type            cyclicAMI;
    }
    AMI2
    {
        type            cyclicAMI;
    }
    procBoundary5to0
    {
        type            processor;
    }
    procBoundary5to1
    {
        type            processor;
    }
    procBoundary5to2
    {
        type            processor;
    }
    procBoundary5to3
    {
        type            processor;
    }
    procBoundary5to4
    {
        type            processor;
    }
}


